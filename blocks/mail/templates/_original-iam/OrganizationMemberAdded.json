 "templateBody": "<!doctype html>\n<html lang=\"en\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Email</title>\n<!--[if mso]>\n<xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>\n<![endif]-->\n<style>\n/* Apple Mail and iOS auto-detect dates, addresses and phone numbers and\n   repaint them as blue underlined links. This hands them back to the\n   surrounding text; links the template actually declares are untouched,\n   because they carry their own inline colour. */\na[x-apple-data-detectors] { color:inherit !important; text-decoration:none !important; }\n@media only screen and (max-width:560px) {\n  .mc-col { display:block !important; width:100% !important; padding-left:0 !important; padding-right:0 !important; }\n  .mc-stack { display:block !important; }\n  .mc-stack > div { width:100% !important; }\n  img { max-width:100% !important; height:auto !important; }\n}\n</style>\n</head>\n<body bgcolor=\"#f4f5f7\" style=\"margin:0;padding:0;background:#f4f5f7;font-family:Arial, Helvetica, sans-serif;color:#172033;-webkit-font-smoothing:antialiased;-webkit-text-size-adjust:100%;text-size-adjust:100%;\">\n<table role=\"presentation\" bgcolor=\"#f4f5f7\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f4f5f7;mso-table-lspace:0pt;mso-table-rspace:0pt;\">\n  <tr><td align=\"center\" style=\"padding:32px 16px;\">\n    <!--[if mso]><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"mso-table-lspace:0pt;mso-table-rspace:0pt;\"><tr><td><![endif]-->\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background:#ffffff;border-radius:8px;overflow:hidden;mso-table-lspace:0pt;mso-table-rspace:0pt;\">\n      <tr>\n        <td style=\"padding:32px 32px 8px 32px;background:#ffffff;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"mso-table-lspace:0pt;mso-table-rspace:0pt;\"><tr>\n          <td width=\"100%\" valign=\"top\" style=\"padding:0 0px;\">\n            <div style=\"margin:0\"><h1 style=\"margin: 0px; padding: 8px 0px; font-size: 20px; line-height:28px; text-align: left; font-weight: bold; letter-spacing: -0.01em; color: rgb(17, 24, 39); outline: currentcolor; overflow-wrap: anywhere; word-break: break-word; font-family: Arial, Helvetica, sans-serif;mso-line-height-rule:exactly;\">You have been added to an organization</h1></div>\n          </td>\n          </tr></table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:16px 32px 0px 32px;background:#ffffff;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"mso-table-lspace:0pt;mso-table-rspace:0pt;\"><tr>\n          <td width=\"100%\" valign=\"top\" style=\"padding:0 0px;\">\n            <div style=\"margin:0\"><div style=\"padding: 10px 0px; font-size: 15px; line-height:24px; text-align: center; font-weight: 400; color: rgb(31, 41, 55); outline: currentcolor; font-family: Arial, Helvetica, sans-serif; overflow-wrap: anywhere; word-break: break-word;mso-line-height-rule:exactly;\"><p style=\"margin:0px 0px 16px\">Hello {{DisplayName}},</p><p style=\"margin:0px 0px 24px\">You have been added to the organization <strong>{{OrganizationName}}</strong></p></div></div>\n          </td>\n          </tr></table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:12px 16px 4px 16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"mso-table-lspace:0pt;mso-table-rspace:0pt;\"><tr>\n          <td class=\"mc-col\" width=\"50%\" valign=\"top\" style=\"padding:0 0px;\">\n            <div style=\"margin:0\"><div style=\"padding: 10px 0px; font-size: 14px; line-height:22px; text-align: center; font-weight: 400; color: rgb(107, 114, 128); outline: currentcolor; font-family: Arial, Helvetica, sans-serif; overflow-wrap: anywhere; word-break: break-word;mso-line-height-rule:exactly;\">Organization</div></div>\n          </td>\n          <td class=\"mc-col\" width=\"50%\" valign=\"top\" style=\"padding:0 0px;\">\n            <div style=\"margin:0\"><div style=\"padding: 10px 0px; font-size: 14px; line-height:22px; text-align: center; font-weight: bold; color: rgb(31, 41, 55); outline: currentcolor; font-family: Arial, Helvetica, sans-serif; overflow-wrap: anywhere; word-break: break-word;mso-line-height-rule:exactly;\">{{OrganizationName}}</div></div>\n          </td>\n          </tr></table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:4px 16px 4px 16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"mso-table-lspace:0pt;mso-table-rspace:0pt;\"><tr>\n          <td class=\"mc-col\" width=\"50%\" valign=\"top\" style=\"padding:0 0px;\">\n            <div style=\"margin:0\"><div style=\"padding: 10px 0px; font-size: 14px; line-height:22px; text-align: center; font-weight: 400; color: rgb(107, 114, 128); outline: currentcolor; font-family: Arial, Helvetica, sans-serif; overflow-wrap: anywhere; word-break: break-word;mso-line-height-rule:exactly;\">Account</div></div>\n          </td>\n          <td class=\"mc-col\" width=\"50%\" valign=\"top\" style=\"padding:0 0px;\">\n            <div style=\"margin:0\"><div style=\"padding: 10px 0px; font-size: 14px; line-height:22px; text-align: center; font-weight: 400; color: rgb(31, 41, 55); outline: currentcolor; font-family: Arial, Helvetica, sans-serif; overflow-wrap: anywhere; word-break: break-word;mso-line-height-rule:exactly;\">{{Email}}</div></div>\n          </td>\n          </tr></table>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding:24px 32px 32px 32px;background:#ffffff;\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"mso-table-lspace:0pt;mso-table-rspace:0pt;\"><tr>\n          <td width=\"100%\" valign=\"top\" style=\"padding:0 0px;\">\n            <div style=\"margin:0\"><div style=\"padding: 10px 0px; font-size: 15px; line-height:24px; text-align: center; font-weight: 400; color: rgb(31, 41, 55); outline: currentcolor; font-family: Arial, Helvetica, sans-serif; overflow-wrap: anywhere; word-break: break-word;mso-line-height-rule:exactly;\"><p style=\"margin:0px 0px 16px\">The next time you sign in, you will have access to this organization.</p><p style=\"font-size:13px;color:rgb(107, 114, 128);line-height:20px;margin:0px;mso-line-height-rule:exactly;\">If you did not expect this change, please contact your administrator.</p></div></div>\n          </td>\n          </tr></table>\n        </td>\n      </tr>\n    </table>\n    <!--[if mso]></td></tr></table><![endif]-->\n  </td></tr>\n</table>\n</body>\n</html>",
